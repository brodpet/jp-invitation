# Google Apps Script web app URL (see docs/SHEETS-SETUP.md). Leave unset locally to use data/guests.dev.json
SHEETS_WEBHOOK_URL=
# Must match ADMIN_SECRET in the Apps Script. Protects the list/add actions.
SHEETS_ADMIN_SECRET=
# Password for /admin
ADMIN_PASSWORD=
# Optional: used to build invitation links in /admin (defaults to the request host)
NEXT_PUBLIC_SITE_URL=
